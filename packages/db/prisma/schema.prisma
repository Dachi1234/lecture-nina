generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  nameLatin     String?
  emailVerified Boolean         @default(false)
  image         String?
  role          Role            @default(STUDENT)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  invites       Invite[]
  student       StudentProfile?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

enum ContactChannel {
  PHONE
  WHATSAPP
  TELEGRAM
  EMAIL
}

enum Goal {
  TRAVEL
  STUDY
  RELOCATION
  FUN
  OTHER
}

enum TimeOfDay {
  MORNING
  DAY
  EVENING
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  TRIAL_DONE
  CONVERTED
  LOST
}

model StudentProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  preferredChannel ContactChannel?
  goal             Goal?
  goalNote         String?
  giftLessonsLeft  Int               @default(2)
  greetingForm     String            @default("feminine")
  leadId           String?           @unique
  lead             Lead?             @relation(fields: [leadId], references: [id])
  onboardedAt      DateTime?
  enrollments      Enrollment[]
  memberships      GroupMember[]
  lessons          Lesson[]
  progress         LessonProgress[]
  attempts         ExerciseAttempt[]
  notes            TeacherNote[]
  checklist        ChecklistItem[]
  words            PersonalWord[]
}

model Lead {
  id        String          @id @default(cuid())
  name      String
  phone     String
  email     String?
  channel   ContactChannel
  goal      Goal?
  days      String[]
  timeOfDay TimeOfDay?
  note      String?
  consentAt DateTime
  source    String?
  utm       Json?
  status    LeadStatus      @default(NEW)
  adminNote String?
  student   StudentProfile?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// ---------- Curriculum: Course → Unit → LessonPlan → PlanItem ----------

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  level         String?
  descriptionKa String?
  order         Int          @default(0)
  isArchived    Boolean      @default(false)
  units         Unit[]
  enrollments   Enrollment[]
  groups        Group[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Unit {
  id        String       @id @default(cuid())
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Int
  titleKa   String
  titleEs   String?
  summaryKa String?
  plans     LessonPlan[]

  @@index([courseId, order])
}

enum PlanSection {
  WARMUP
  CLASS
  HOMEWORK
  REVIEW
}

model LessonPlan {
  id           String     @id @default(cuid())
  unitId       String?
  unit         Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order        Int        @default(0)
  titleKa      String
  titleEs      String?
  goalsKa      String[]
  teacherNotes String?
  estMinutes   Int?
  items        PlanItem[]
  lessons      Lesson[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([unitId, order])
}

model PlanItem {
  id         String       @id @default(cuid())
  planId     String
  plan       LessonPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  materialId String
  material   Material     @relation(fields: [materialId], references: [id])
  section    PlanSection  @default(CLASS)
  order      Int          @default(0)
  noteKa     String?
  overrides  LessonItem[]

  @@unique([planId, materialId])
}

// ---------- Audience: enrollments and groups ----------

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    EnrollmentStatus @default(ACTIVE)
  startedAt DateTime         @default(now())

  @@unique([studentId, courseId])
}

model Group {
  id         String        @id @default(cuid())
  name       String
  courseId   String?
  course     Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  noteKa     String?
  isArchived Boolean       @default(false)
  members    GroupMember[]
  lessons    Lesson[]
  createdAt  DateTime      @default(now())
}

model GroupMember {
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime       @default(now())

  @@id([groupId, studentId])
}

enum MaterialType {
  INFO_CARD
  VOCAB
  DIALOGUE
  STORY
  VIDEO
  AUDIO
  DOCUMENT
  GRAMMAR
  EXERCISE
  GAME
  PRONUNCIATION
  GRADED_READER
  CHECKPOINT
  HTML_EMBED
}

enum MaterialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MaterialOrigin {
  MANUAL
  AI_AGENT
  IMPORTED
}

model Material {
  id                   String             @id @default(cuid())
  type                 MaterialType
  title                String
  subtitle             String?
  description          String?
  content              Json
  draft                Json?
  contentSchemaVersion Int                @default(1)
  status               MaterialStatus     @default(DRAFT)
  origin               MaterialOrigin     @default(MANUAL)
  tags                 String[]
  level                String?
  estMinutes           Int?
  legacySourceId       String?
  assets               MaterialAsset[]
  planItems            PlanItem[]
  lessonItems          LessonItem[]
  progress             LessonProgress[]
  revisions            MaterialRevision[]
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model MaterialRevision {
  id          String   @id @default(cuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  content     Json
  title       String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model MediaAsset {
  id           String                @id @default(cuid())
  kind         AssetKind
  originalName String
  mime         String
  sizeBytes    BigInt
  storageKey   String                @unique
  checksum     String?
  status       AssetStatus           @default(UPLOADING)
  width        Int?
  height       Int?
  durationSec  Float?
  pageCount    Int?
  variants     Json?
  alt          String?
  tags         String[]
  usedBy       MaterialAsset[]
  legacyUsedBy LegacyMaterialAsset[]
  createdAt    DateTime              @default(now())
}

model MaterialAsset {
  materialId String
  assetId    String
  role       String
  order      Int        @default(0)
  material   Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  asset      MediaAsset @relation(fields: [assetId], references: [id])

  @@id([materialId, assetId, role])
}

// ---------- Delivery: a Lesson is one dated session for one student or one group ----------

model Lesson {
  id            String           @id @default(cuid())
  planId        String?
  plan          LessonPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  studentId     String?
  student       StudentProfile?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId       String?
  group         Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title         String?
  date          DateTime
  durationMin   Int?
  noteKa        String?
  privateNote   String?
  homeworkDueAt DateTime?
  publishedAt   DateTime?
  heldAt        DateTime?
  isGift        Boolean          @default(false)
  items         LessonItem[]
  progress      LessonProgress[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([studentId, date])
  @@index([groupId, date])
}

// Plan items show up in a lesson automatically. A LessonItem either tweaks one of them
// (planItemId set: hide or hold it) or adds an extra item (materialId set).
model LessonItem {
  id         String      @id @default(cuid())
  lessonId   String
  lesson     Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  planItemId String?
  planItem   PlanItem?   @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material?   @relation(fields: [materialId], references: [id])
  section    PlanSection @default(CLASS)
  order      Int         @default(0)
  noteKa     String?
  hidden     Boolean     @default(false)
  held       Boolean     @default(false)

  @@unique([lessonId, planItemId])
  @@unique([lessonId, materialId])
}

enum ProgressStatus {
  NOT_STARTED
  OPENED
  COMPLETED
}

model LessonProgress {
  studentId   String
  lessonId    String
  materialId  String
  status      ProgressStatus @default(NOT_STARTED)
  openedAt    DateTime?
  completedAt DateTime?
  lastStep    Int?
  bestScore   Float?
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  material    Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([studentId, lessonId, materialId])
  @@index([studentId, materialId])
}

model ExerciseAttempt {
  id                String         @id @default(cuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materialId        String
  lessonId          String?
  contentRevisionId String?
  answers           Json
  score             Float?
  correct           Int?
  total             Int?
  finishedAt        DateTime?
  createdAt         DateTime       @default(now())
}

model TeacherNote {
  id               String         @id @default(cuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  body             String
  materialId       String?
  visibleToStudent Boolean        @default(true)
  createdAt        DateTime       @default(now())
}

model ChecklistItem {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String?
  text      String
  done      Boolean        @default(false)
  order     Int            @default(0)
}

model PersonalWord {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  es        String
  ka        String
  en        String?
  noteKa    String?
  createdAt DateTime       @default(now())
}

// ---------- Legacy library: read-only reference of the first content set ----------

model LegacyMaterial {
  id          String                @id
  type        MaterialType
  title       String
  subtitle    String?
  description String?
  content     Json
  status      MaterialStatus
  tags        String[]
  estMinutes  Int?
  unitLabel   String?
  topicLabel  String?
  topicOrder  Int?
  assets      LegacyMaterialAsset[]
  createdAt   DateTime
  migratedAt  DateTime              @default(now())
}

model LegacyMaterialAsset {
  legacyMaterialId String
  assetId          String
  role             String
  order            Int            @default(0)
  material         LegacyMaterial @relation(fields: [legacyMaterialId], references: [id], onDelete: Cascade)
  asset            MediaAsset     @relation(fields: [assetId], references: [id])

  @@id([legacyMaterialId, assetId, role])
}

model LegacyWord {
  id            String  @id
  es            String
  ka            String
  en            String?
  pronunciation String?
  category      String?
  topicLabel    String?
  topicOrder    Int?
}

model SiteSetting {
  key   String @id
  value Json
}

model AgentThread {
  id          String         @id @default(cuid())
  title       String?
  createdById String
  messages    AgentMessage[]
  runs        AgentRun[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AgentMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   Json
  createdAt DateTime    @default(now())
}

model AgentRun {
  id           String      @id @default(cuid())
  threadId     String
  thread       AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  status       String
  model        String
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  error        String?
  createdAt    DateTime    @default(now())
  finishedAt   DateTime?
}

model PromptTemplate {
  id   String   @id @default(cuid())
  name String
  body String
  tags String[]
}

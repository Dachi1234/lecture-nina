{
  "$description": "Nina – Tu Profe de Español · design tokens (W3C design-tokens style). No dark mode.",
  "color": {
    "brand": {
      "paper":       { "$value": "#FCF7E6", "$description": "Page background (logo cream)" },
      "teal-deep":   { "$value": "#196166", "$description": "Primary UI: buttons, links, active states" },
      "navy-teal":   { "$value": "#0A414F", "$description": "Headings, text, dark sections, footer" },
      "burgundy":    { "$value": "#841B22", "$description": "Accent, CTA variant, errors" },
      "mustard":     { "$value": "#F5B246", "$description": "Brush underlines, badges, focus ring. Never text on cream." },
      "warm-sand":   { "$value": "#D0AC84", "$description": "Borders, dividers. Never text." },
      "sage":        { "$value": "#5B8A81", "$description": "Calm accent, success / completed" }
    },
    "state": {
      "teal-deep-hover": { "$value": "#124D51" },
      "burgundy-hover":  { "$value": "#6C141A" },
      "mustard-deep":    { "$value": "#E89A2E" },
      "disabled-bg":     { "$value": "#D9D3C2" },
      "disabled-fg":     { "$value": "#6F7D7F" }
    },
    "surface": {
      "paper-deep":  { "$value": "#F6EDD3" },
      "sand-soft":   { "$value": "#F1E3C8" },
      "card":        { "$value": "#FFFCF3" },
      "exercise":    { "$value": "#F3EAD6" },
      "line":        { "$value": "#E4D3B4" },
      "line-soft":   { "$value": "#EFE3CB" },
      "tile-border": { "$value": "#C9B08E" }
    },
    "tint": {
      "teal-soft":      { "$value": "#DCEAE6" },
      "teal-softer":    { "$value": "#E4EFEC" },
      "burgundy-soft":  { "$value": "#F4DEDA" },
      "mustard-soft":   { "$value": "#FCE8C0" },
      "sage-soft":      { "$value": "#E0EAE3" },
      "pronunciation":  { "$value": "#D6E9C9", "$description": "Only for pronunciation circles" },
      "terracotta":     { "$value": "#C8734B", "$description": "Illustration detail only (roofs on path map)" }
    },
    "text": {
      "default":        { "$value": "#0A414F", "$description": "10.4:1 on paper" },
      "muted":          { "$value": "#4A6268", "$description": "6.0:1 on paper" },
      "on-dark":        { "$value": "#FCF7E6" },
      "on-dark-muted":  { "$value": "#CFE0DB" },
      "on-dark-soft":   { "$value": "#E6DEC8" },
      "status-progress":{ "$value": "#7A4A00", "$description": "on mustard-soft" },
      "status-done":    { "$value": "#34605A", "$description": "on sage-soft" }
    }
  },
  "font": {
    "family": {
      "sans":  { "$value": "\"FiraGO\", \"Montserrat\", system-ui, sans-serif", "$description": "FiraGO loaded with Georgian unicode-range only" },
      "latin": { "$value": "\"Montserrat\", system-ui, sans-serif" },
      "hand":  { "$value": "\"Caveat\", cursive", "$description": "Short Spanish accents only. Never Georgian, body text or exercises." }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } }
  },
  "typography": {
    "display":  { "$value": { "fontSize": "64px", "lineHeight": 1.1,  "fontWeight": 700, "letterSpacing": "-0.02em" } },
    "hero-brand": { "$value": { "fontSize": "120px", "lineHeight": 1, "fontWeight": 700, "letterSpacing": "-0.02em", "fontFamily": "Montserrat" }, "$description": "'Nina' in hero; mobile 72px" },
    "h1":       { "$value": { "fontSize": "48px", "lineHeight": 1.15, "fontWeight": 700 } },
    "h2":       { "$value": { "fontSize": "36px", "lineHeight": 1.2,  "fontWeight": 700 }, "$description": "Landing section titles 46px desktop / 30px mobile" },
    "h3":       { "$value": { "fontSize": "24px", "lineHeight": 1.3,  "fontWeight": 600 } },
    "body-l":   { "$value": { "fontSize": "20px", "lineHeight": 1.6,  "fontWeight": 400 } },
    "body":     { "$value": { "fontSize": "18px", "lineHeight": 1.6,  "fontWeight": 400 }, "$description": "Mobile 16px" },
    "small":    { "$value": { "fontSize": "14px", "lineHeight": 1.5,  "fontWeight": 400 } },
    "overline": { "$value": { "fontSize": "12px", "lineHeight": 1.4,  "fontWeight": 600, "letterSpacing": "0.08em", "textTransform": "uppercase", "fontFamily": "Montserrat" }, "$description": "Latin labels only (VOCABULARIO, DIÁLOGO)" },
    "hand":     { "$value": { "fontSize": "28–76px", "lineHeight": 1, "fontWeight": 600, "fontFamily": "Caveat" } }
  },
  "space": { "1": {"$value":"4px"}, "2": {"$value":"8px"}, "3": {"$value":"12px"}, "4": {"$value":"16px"}, "5": {"$value":"20px"}, "6": {"$value":"24px"}, "8": {"$value":"32px"}, "10": {"$value":"40px"}, "12": {"$value":"48px"}, "16": {"$value":"64px"}, "24": {"$value":"96px"}, "30": {"$value":"120px"} },
  "layout": {
    "container": {"$value":"1280px"}, "gutter": {"$value":"24px"}, "margin-desktop": {"$value":"80px"}, "margin-mobile": {"$value":"20px"},
    "columns-desktop": {"$value":12}, "columns-mobile": {"$value":4},
    "header": {"$value":"88px"}, "header-scrolled": {"$value":"68px"}, "header-mobile": {"$value":"64px"},
    "sidebar": {"$value":"248px"}, "tabbar": {"$value":"64px"},
    "breakpoints": {"$value": {"sm":"390px","md":"768px","lg":"1024px","xl":"1440px"}}
  },
  "radius": {
    "sm": {"$value":"8px","$description":"tags, word tiles"}, "md": {"$value":"12px","$description":"inputs, buttons"}, "btn-l": {"$value":"14px"},
    "lg": {"$value":"16px","$description":"cards"}, "xl": {"$value":"20px","$description":"panels, exercise frame"}, "2xl": {"$value":"24px","$description":"modal"},
    "pill": {"$value":"999px","$description":"chips only — primary buttons are never pills"},
    "mask-blob": {"$value":"46% 54% 40% 60% / 34% 36% 64% 66%"}, "mask-arch": {"$value":"999px 999px 20px 20px"}
  },
  "shadow": {
    "lift": {"$value":"0 18px 36px -22px rgba(10,65,79,.5)"},
    "card-hover": {"$value":"0 22px 44px -24px rgba(10,65,79,.45)"},
    "device": {"$value":"0 30px 60px -30px rgba(10,65,79,.6)"},
    "modal": {"$value":"0 40px 80px -30px rgba(0,0,0,.5)"},
    "btn-hover": {"$value":"0 10px 24px -10px rgba(10,65,79,.55)"},
    "scrim": {"$value":"rgba(10,65,79,.55)"}
  },
  "motion": {
    "duration-fast": {"$value":"150ms"}, "duration-base": {"$value":"200ms"}, "duration-slow": {"$value":"250ms"},
    "lift-button": {"$value":"-2px"}, "lift-card": {"$value":"-4px"},
    "hero-write-on": {"$value":"clip-path reveal 1.2s, delay .35s"}, "nina-float": {"$value":"translateY(-8px) 7s ease-in-out infinite"},
    "reduced-motion": {"$value":"disable all animation"}
  },
  "focus": { "ring": {"$value":"3px solid #F5B246, offset 3px"}, "input": {"$value":"border #196166 + 0 0 0 4px #DCEAE6"} }
}
